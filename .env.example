# Database mode
# Local development uses a file-backed libSQL/SQLite database by default.
DATABASE_URL=file:local.db

# For Turso/remote libSQL, set these instead. Do not commit real tokens.
# In Vercel, configure these as project environment variables.
# TURSO_DATABASE_URL=libsql://example.turso.io
# TURSO_AUTH_TOKEN=...

# Remote migrations require explicit confirmation for safety.
# You can either run `npm run db:migrate -- --yes` or set:
# DATABASE_MIGRATE_CONFIRM=1

# Required for TB1.04 Route Searches.
# ORS_API_KEY=...

# Optional for MapLibre-compatible basemaps. The fallback is MapLibre demo tiles for local development only.
# Select a named basemap. Supported today: demo-vector, osm-standard-raster, maptiler-outdoor, custom-raster.
# PUBLIC_BASEMAP_ID=demo-vector

# Optional MapTiler Outdoor vector basemap candidate for TB10 free-tier evaluation.
# Register a MapTiler account/key, restrict the key to your deployed domains if available,
# and monitor free API session/request usage before broad sharing.
# PUBLIC_MAPTILER_KEY=...

# Optional vector style override for the demo-vector basemap.
# PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Optional raster tile basemap. Use a provider URL template and required attribution.
# PUBLIC_RASTER_TILE_URL=https://tile-provider.example/{z}/{x}/{y}.png
# PUBLIC_RASTER_TILE_ATTRIBUTION=Map data attribution required by provider
