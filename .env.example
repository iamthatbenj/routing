# Use a local libSQL/SQLite file for development by default.
DATABASE_URL=file:local.db

# For Turso, set these instead:
# TURSO_DATABASE_URL=libsql://example.turso.io
# TURSO_AUTH_TOKEN=...

# Required for TB1.04 Route Searches.
# ORS_API_KEY=...

# Optional for TB2 MapLibre maps. The fallback is MapLibre demo tiles for local development only.
# Use a MapLibre-compatible style.json URL from your chosen vector tile provider.
# PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
